OPENROUTER_API_KEY=your-api-key-here
# Optional: override the OpenRouter model. Default "openrouter/free" routes
# across the whole free pool (dodges per-model rate limits; quality varies
# turn to turn). Pin e.g. "minimax/minimax-m3:free" for consistent behavior.
# OPENROUTER_MODEL=

# --- CopilotKit Intelligence (optional; set COPILOTKIT_LICENSE_TOKEN to enable Threads — server + UI) ---
# COPILOTKIT_LICENSE_TOKEN=
# INTELLIGENCE_API_URL=http://localhost:4201
# INTELLIGENCE_GATEWAY_WS_URL=ws://localhost:4401
# INTELLIGENCE_API_KEY=

# Optional: web search for current trip facts (free tier: app.tavily.com)
# TAVILY_API_KEY=

# Optional: identity for hosted threads (defaults to sacbe-user; replace
# with a real auth-derived id before multi-user deployment)
# COPILOTKIT_USER_ID=
